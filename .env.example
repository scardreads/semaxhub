# Public canonical origin, no trailing slash.
# Leave unset to use https://semaxhub.com.
# Set this to the production origin on every environment. Do not use a preview URL.
# NEXT_PUBLIC_SITE_URL=https://semaxhub.com

DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/discuss
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/discuss
ADMIN_USER_IDS=

# Google Analytics 4 measurement ID (public). Leave unset locally.
# Vercel production falls back to G-78DELVNFMX when this is unset.
# Set it on Vercel Preview to collect preview hits. Set it to empty to disable.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-78DELVNFMX
